# Copy to backend/.env; keep private (never commit)
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DATABASE_URL=postgresql://postgres.PROJECT_REF:your-password@POOLER_HOST:5432/postgres
DATABASE_SSL_CA_PATH=certs/prod-ca-2021.crt
