@startuml Master_FullDepth_v1_Relayout
title Master Diagram v1 — CloudStock Warehouse Management System & Deployment-Safe Infrastructure

' ==============================================================================
' ARCHITECTURAL DESIGN & LAYOUT PRINCIPLES
' - Request path reads left-to-right (People -> Edge -> Next.js Runtime -> Data).
' - Delivery / CI-CD and Schema Evolution live above the runtime.
' - Telemetry, Distributed Tracing and Multiplexed Error Sinks live below the runtime.
' - Operations, Watchability, Alert Routing and Dashboards are right-side outcomes.
' - Color convention: Quiet by default; only primary operational paths receive strong colors.
' ==============================================================================

left to right direction
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 42
skinparam shadowing false

' Line & font styling
skinparam ArrowColor #94A3B8
skinparam ArrowFontColor #64748B
skinparam ArrowThickness 1

' Component color palette by functional domain
skinparam component {
  BackgroundColor<<human>> #FFECB3
  BackgroundColor<<dns>> #ECEFF1
  BackgroundColor<<security>> #FFEBEE
  BackgroundColor<<cicd>> #FFF3E0
  BackgroundColor<<source>> #FFF9C4
  BackgroundColor<<cache>> #FFF8E1
  BackgroundColor<<vercel>> #E1F5FE
  BackgroundColor<<supabase>> #E8F5E9
  BackgroundColor<<external>> #FCE4EC
  BackgroundColor<<trace>> #D1C4E9
  BackgroundColor<<cost>> #F1F8E9
  BackgroundColor<<viz>> #EDE7F6
  BackgroundColor<<alert>> #FFCDD2
  BackgroundColor<<incident>> #FFCCBC
  BackgroundColor<<selfhost>> #E0F7FA
  BorderColor Black
}

' ==============================================================================
' SECTION 01: ACTORS & RBAC ROLES (NGHIỆP VỤ PHÂN QUYỀN NGƯỜI DÙNG)
' Nghiệp vụ: Hệ thống phân quyền 3 cấp (Role-Based Access Control) cho CloudStock:
' - Admin: Toàn quyền cấu hình SKU, danh mục, đơn vị, quản lý tài khoản, xem & xuất báo cáo.
' - Staff (Kho): Vận hành xuất/nhập tồn (IN/OUT), tra cứu tồn kho tức thời, chặn xem báo cáo nhạy cảm.
' - Viewer (Kiểm toán/Kế toán): Xem Dashboard tổng quan, phân tích trend tồn kho, xuất báo cáo CSV.
' - Engineering Team: Kỹ sư phụ trách hạ tầng và triển khai (Owner Dev, Collaborators).
' ==============================================================================
package "01 · People / engineering team" <<human>> {
  actor "CloudStock Users\n(Admin · Staff · Viewer)" as User
  actor "Partner Developer\n(collaborator)" as Partner
}

' ==============================================================================
' SECTION 02: EDGE & INGRESS SECURITY (CỔNG BIÊN & BẢO VỆ MẠNG)
' Nghiệp vụ: Cổng tiếp nhận lưu lượng công cộng (*.vercel.app - Free Tier / No custom domain):
' - Vercel DNS: Phân giải tên miền máy chủ không dùng custom domain / Cloudflare DNS.
' - Vercel Firewall (WAF): Chặn các cuộc tấn công web phổ biến (Hobby tier: 3 custom rules).
' - Rate Limiting: Chống brute-force / spam login (Hobby tier: 1 rule dự án).
' - Bot Management: Phát hiện và loại bỏ lưu lượng crawler / bot tự động trước khi vào app.
' ==============================================================================
package "02 · Edge" <<dns>> {
  component "Vercel domain / DNS\n(*.vercel.app · no custom domain)" as DNS <<dns>>
  component "Vercel Firewall\n(Hobby: 3 custom rules)" as WAF <<security>>
  component "Rate Limiting\n(Hobby: 1 rule / project)" as RateLimit <<security>>
  component "Bot Management" as BotMgmt <<security>>
}

' ==============================================================================
' SECTION 03: NEXT.JS RUNTIME & BUSINESS ROUTE HANDLERS (ỨNG DỤNG & XỬ LÝ NGHIỆP VỤ KHO)
' Nghiệp vụ: Kiến trúc Serverless 100% trên Next.js 16 (App Router) & React 19:
' - Middleware: Bắt chặn Edge, inject W3C TraceContext headers và điều hướng.
' - Client Components (CSR): Dashboard tương tác (Tabs: Overview, Products, Categories, Stock, Reports, Users).
' - Server Components (RSC): Prefetch layout dữ liệu ban đầu trên Node.js runtime.
' - Route Handlers (Nghiệp vụ cốt lõi):
'   + /api/auth/me & /api/users/*: Xác thực JWT Supabase Auth, RBAC Policy Guard, quản lý tài khoản.
'   + /api/categories & /api/units: Quản lý danh mục hàng hóa và đơn vị tính (Master Data).
'   + /api/products/*: CRUD thông tin sản phẩm, định mức tồn kho tối thiểu (minimum_stock).
'   + /api/movements: Xử lý giao dịch Nhập (IN) / Xuất (OUT) kho nguyên tử (SELECT ... FOR UPDATE).
'   + /api/reports/*: Phân tích Overview, Trend 14d/12w/12m, cảnh báo Low-stock, xuất CSV UTF-8 BOM.
'   + /api/health: Active PostgREST keep-alive ping chống Supabase Free-Tier tạm dừng (pause).
'   + /api/debug/telemetry: Endpoint kiểm thử định tuyến lỗi Sentry và Bugsink.
' ==============================================================================
package "03 · Next.js / Vercel runtime" <<source>> {
  component "Middleware\nEdge Runtime" as Middleware <<source>>
  component "Server Components\nNode.js" as RSC <<source>>
  component "Client Components\nBrowser (CloudStock UI)" as CSR <<source>>
  component "Route Handlers\nNode.js (Inventory API Engine)" as RouteHandler <<source>>
  component "Server Actions\nNode.js" as ServerAction <<source>>
}

' ==============================================================================
' SECTION 04: CACHE, ACCELERATION & KV LAYER (BỘ NHỚ ĐỆM & TỐI ƯU TRUY VẤN)
' Nghiệp vụ: Đảm bảo độ trễ thấp và giảm tải cho cơ sở dữ liệu Supabase Free Tier:
' - Vercel Edge Cache: Lưu trữ tài nguyên tĩnh (assets, static JS/CSS).
' - ISR Cache & Fetch Data Cache: Cache phản hồi dữ liệu ít biến động.
' - Vercel KV / Upstash Redis: Cache-aside cho các session và token blacklist (tùy chọn).
' - In-Memory Profile Cache: Cache quyền hạn người dùng (TTL 30s) có cơ chế Request Deduplication.
' ==============================================================================
package "04 · Cache & KV" <<cache>> {
  component "Vercel Edge Cache" as EdgeCache <<cache>>
  component "ISR Cache" as ISRCache <<cache>>
  component "Fetch Data Cache" as FetchCache <<cache>>
  component "Vercel KV" as VercelKV <<cache>>
  component "Upstash Redis" as Upstash <<cache>>
}

' ==============================================================================
' SECTION 05: SUPABASE DATA & INVENTORY ENTITIES (CƠ SỞ DỮ LIỆU & THỰC THỂ KHO)
' Nghiệp vụ: Lưu trữ dữ liệu chuẩn hóa quan hệ PostgreSQL trên Supabase:
' - Supavisor Connection Pooler: Cổng kết nối port 6543 (Transaction Mode) bảo vệ connection limit.
' - Supabase Postgres Schema:
'   + profiles: [id (auth.uid), display_name, role (admin/staff/viewer), is_active].
'   + categories & units: Phân loại ngành hàng và đơn vị quy chuẩn (cái, quyển, ram).
'   + products: Mã SKU độc bản, tên, category_id, unit_id, cost_price, stock_quantity, minimum_stock.
'   + stock_movements: Sổ cái lịch sử nhập/xuất [type, quantity, balance_after, note, performed_by].
' - Backup / PITR: Sao lưu dump off-site định kỳ bảo vệ an toàn dữ liệu trên gói miễn phí.
' ==============================================================================
package "05 · Supabase data" <<supabase>> {
  component "Supavisor\nPooler (Port 6543)" as Supavisor <<supabase>>
  component "Supabase Postgres\n(CloudStock Inventory DB)" as SupaDB <<supabase>>
  component "Backup / PITR\n(Free: db dump off-site;\nPITR = paid add-on)" as SupaBackup <<supabase>>
}

