# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# WARNING: NEVER commit actual live secrets or tokens into version control.
#
# Boundary Classification:
# 1. Browser-safe variables (prefixed with NEXT_PUBLIC_) are exposed to client bundles.
# 2. Server/CI secrets (NO prefix) are strictly restricted to Node.js server runtime and CI pipelines.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE CLIENT CONFIGURATION (NEXT_PUBLIC_*)
# Safe to expose in the browser client bundle.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o000000.ingest.sentry.io/0000000

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY & CI/CD CREDENTIALS (RESTRICTED)
# NEVER prefix with NEXT_PUBLIC_. Strictly executed on Vercel Serverless / CI runners.
# ------------------------------------------------------------------------------
# Supabase Privileged Service Role Key (Bypasses Row Level Security for admin actions)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Supavisor Pooled Connection String (Transaction Mode, Port 6543)
# Used STRICTLY by Next.js application runtime (Server Components, Route Handlers)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct PostgreSQL Connection String (Session Mode, Port 5432)
# Used STRICTLY by migration tooling and CI schema gates (supabase db push)
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Sentry Auth Token for CI Source Map Uploads (Never expose to client)
SENTRY_AUTH_TOKEN=your-sentry-auth-token-placeholder

# ------------------------------------------------------------------------------
# 3. OPTIONAL CACHE INFRASTRUCTURE (Vercel KV / Upstash Redis)
# Placeholders for future cache integration layers.
# ------------------------------------------------------------------------------
KV_REST_API_URL=https://your-kv-database.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token-placeholder
